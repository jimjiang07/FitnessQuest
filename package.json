{
  "name": "fitness-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice-coached workouts for a 4-day spine rehab split: pick a day, press start, follow the coach. No login, no tracking.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc -b",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "node scripts/check-plan.mjs && vitest run && playwright test",
    "check-plan": "node scripts/check-plan.mjs",
    "voice": "node scripts/make-voice.mjs",
    "figures": "node scripts/make-figures.mjs public/exercises"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.6",
    "@fontsource/manrope": "^5.2.8",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  }
}
